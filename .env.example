# Salin menjadi .env.local lalu isi. Semua variabel ini dibaca saat build (static export).

# Alamat situs final (sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=https://tumbuhnusantara.my.id

# Sinkronisasi opsional antarperangkat (Supabase). Kosongkan untuk mematikan fitur ini.
# Ambil dari Supabase: Project Settings > API (Project URL dan anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
